def type_out(text, delay=0.13):
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(delay)
    sys.stdout.write('\n')
    sys.stdout.flush()

def play_lyrics(lyrics):
    for line, line_delay in lyrics:
        type_out(line)
        time.sleep(line_delay)

